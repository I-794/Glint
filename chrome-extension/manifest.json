{
  "manifest_version": 3,
  "name": "Glint Capture",
  "version": "1.1.0",
  "description": "Capture any webpage (visible area, full page, or a region) and open it in the Glint studio to frame, annotate, and export.",
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Glint Capture"
  },
  "background": { "service_worker": "background.js" },
  "permissions": ["activeTab", "scripting", "tabs", "storage"],
  "host_permissions": ["https://snapshotpro.xyz/*", "http://localhost/*"],
  "content_scripts": [
    {
      "matches": ["https://snapshotpro.xyz/editor/*", "http://localhost/editor/*"],
      "js": ["content/bridge.js"],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
